# PushTransfer 运行时配置模板
# 复制为 .env（不要提交）并在部署环境里导入，或用容器/编排平台的密钥管理注入。
# 各投递与触发通道均为按需启用（见 internal/config/config.go）；注释中给出默认值的可留空不写。

# ---- 服务监听与运行模式 ----
# HTTP 服务监听端口，默认 8889（兼容 SERVER_PORT）
PORT=8889
# 是否启用 IMAP 邮件触发监听（true / 1 启用，默认 false）
# 注意：Webhook 绝不以无鉴权方式提供服务。若未配置 AUTH_CREDENTIALS 且 RUN_TRIGGER 不为 true，
# 进程会在启动时直接报错退出；只有 RUN_TRIGGER=true（纯 IMAP 模式，不监听 HTTP）才允许无凭据运行。
RUN_TRIGGER=false

# ---- Webhook / 认证 ----
# 唯一凭据来源：单行严格 JSON 数组（不要跨行，环境变量按行注入）。
# 每项支持 name（审计标识，不得以保留前缀 env: 开头）、token、username、password；
# 每项必须包含 token 或成对的 username+password（或两者兼备）。
# 同一个 token 或同一组 username+password 只能出现一次，重复即启动报错（避免审计身份二义性）。
# 数组不得为空；最多 64 项；name 最长 64 字符；校验失败只报变量名/条目序号/字段名，绝不回显凭据内容。
# 示例: AUTH_CREDENTIALS='[{"name":"phone-a","token":"<随机串>"},{"name":"tablet","username":"user","password":"pass"}]'
AUTH_CREDENTIALS=
# 显式信任的反向代理 IP 列表（逗号分隔，兼容 WEBHOOK_TRUSTED_PROXIES）；默认仅信任 Loopback 与内网私网代理
TRUSTED_PROXIES=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 默认 https://api.telegram.org ，可留空不写（支持本地反代或兼容 TELEGRAM_BASE_URL）
TELEGRAM_API_URL=

# ---- Bark ----
# 设备 key 与 URL 列表均为逗号分隔
BARK_DEVICE_KEY_LIST=
BARK_URL_LIST=
# 兼容配置：若未设置 BARK_POST_URL，系统会自动从 BARK_GET_URL 推导 <BARK_GET_URL>/push
BARK_GET_URL=
# 默认 https://api.day.app/push ，可留空不写
BARK_POST_URL=

# ---- AES-128 加密（Bark 密文推送，需恰好 16 个 ASCII 字符）----
# Bark 客户端按“字符数”校验密钥并使用其原始 UTF-8 字节，因此多字节密钥不受支持（启动即报错）。
AES_128_ECB_KEY=
# [已弃用/忽略] 每条消息都会生成 16 字节安全随机 IV，并以 16 个 ASCII 字符作为与 ciphertext
# 并列的独立 `iv` 参数发送（Bark 官方协议不接受把 IV 拼在密文前缀里）；静态 IV 配置仅用于告警。
AES_128_ECB_IV=

# ---- 邮件投递（SMTP SSL）----
EMAIL_DELIVER_SENDER_EMAIL=
EMAIL_DELIVER_RECEIVER_EMAIL=
EMAIL_DELIVER_PASSWORD=
# 默认 smtp.exmail.qq.com
EMAIL_DELIVER_SMTP_SERVER=
# 默认 465
EMAIL_DELIVER_SMTP_PORT=

# ---- 邮件触发（IMAP SSL）----
EMAIL_TRIGGER_LOGIN_EMAIL=
EMAIL_TRIGGER_PASSWORD=
# 默认 imap.exmail.qq.com
EMAIL_TRIGGER_IMAP_SERVER=
# 默认 993
EMAIL_TRIGGER_IMAP_PORT=
# 监听的邮箱文件夹，默认 INBOX
EMAIL_TRIGGER_MAILBOX=INBOX

# ---- 过滤 / 识别规则 ----
# 均为 JSON 数组形式的正则字符串。列表不能用逗号分隔，因为正则本身可能含逗号
# （例如量词 {m,n}），JSON 数组能无歧义表达且无需为正则做额外转义。
# 注意 JSON 里反斜杠要写两次，正则 \d 应写成 "\\d"。
#
# 黑名单：命中即拦截该条短信
REGEX_FILTER_BLACK=
# 白名单：命中即放行（优先于黑名单判断）
REGEX_FILTER_WHITE=
# 验证码提取
REGEX_CAPTCHA=
# 紧急消息识别（命中则 Bark 以 critical 级别推送）
REGEX_EMERGENCY=
