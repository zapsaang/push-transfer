# PushTransfer 运行时配置模板
# 复制为 .env（不要提交）并在部署环境里导入，或用容器/编排平台的密钥管理注入。
# 【必需】项缺失时 shell/env.py 会在启动阶段直接报错。
# 空值表示必填；注释中给出默认值的可留空不写。

# ---- Webhook / 认证 ----
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_TOKEN=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Bark ----
# 设备 key 与 URL 列表均为逗号分隔
BARK_DEVICE_KEY_LIST=
BARK_URL_LIST=
# 默认 https://api.day.app/ ，可留空不写
BARK_GET_URL=
# 默认 https://api.day.app/push ，可留空不写
BARK_POST_URL=

# ---- AES-128 加密（Bark 密文推送）----
AES_128_ECB_KEY=
AES_128_ECB_IV=

# ---- 邮件投递 ----
EMAIL_DELIVER_SENDER_EMAIL=
EMAIL_DELIVER_RECEIVER_EMAIL=
EMAIL_DELIVER_PASSWORD=
# 默认 smtp.exmail.qq.com
EMAIL_DELIVER_SMTP_SERVER=
# 默认 465
EMAIL_DELIVER_SMTP_PORT=

# ---- 邮件触发（IMAP）----
EMAIL_TRIGGER_LOGIN_EMAIL=
EMAIL_TRIGGER_PASSWORD=
# 默认 imap.exmail.qq.com
EMAIL_TRIGGER_IMAP_SERVER=
# 默认 993
EMAIL_TRIGGER_IMAP_PORT=

# ---- 过滤 / 识别规则 ----
# 均为 JSON 数组形式的正则字符串。列表不能用逗号分隔，因为正则本身可能含逗号
# （例如量词 {m,n}），JSON 数组能无歧义表达且无需为正则做额外转义。
# 注意 JSON 里反斜杠要写两次，正则 \d 应写成 "\\d"。
#
# 黑名单：命中即拦截该条短信
REGEX_FILTER_BLACK=
# 白名单：命中即放行（优先于黑名单判断）
REGEX_FILTER_WHITE=
# 验证码提取
REGEX_CAPTCHA=
# 紧急消息识别（命中则 Bark 以 critical 级别推送）
REGEX_EMERGENCY=
